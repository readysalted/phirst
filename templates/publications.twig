{% extends 'templates/_document.twig' %}

{% block content %}
	<header>
			{{ renderComponent('BlockPostHeader', { type: 'custom', title: 'Publications', subtitle: hero_research_text } ) }}
	</header>
	{{ renderComponent('GridPublicationArchive', { posts: posts, style: 'gridOnly' }) }}
	{% for component in post.meta('pageComponents') %}
		{{ renderComponent(component) }}
	{% endfor %}
	{{ renderComponent('BlockMailingList', {image: footer_cta_img, contentHtml: footer_cta_text, backgroundColor: footer_cta_bg, imagePosition: 'right', spacing: 'spacing-fix'  }) }}
{% endblock %}