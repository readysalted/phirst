{% extends 'templates/_document.twig' %}

{% block content %}
  <article>
    <header>
      {{ renderComponent('BlockPostHeader', {post: post}) }}
    </header>
    <section class="wp-block-post-content has-global-padding is-layout-constrained">
        {{ post.content }}
    </section>
    {% if post.res_accordion_panels %}
      {{ renderComponent({
        'acf_fc_layout': 'AccordionDefault',
        'preContentHtml': post.res_accordion_heading ? '<h2>' ~ post.res_accordion_heading ~ '</h2>' : '',
        'accordionPanels': post.res_accordion_panels
      }) }}
    {% endif %}
    <footer>
      {{ renderComponent('BlockPostFooter', {post: post}) }}
    </footer>
    {# <section>
      {{ renderComponent('GridPostsLatest', {'taxonomies': post.categories(), 'options': {'theme': 'light', 'maxColumns': 3}}) }}
    </section> #}
  </article>
{% endblock %}
