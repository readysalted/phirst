<flynt-component name="BlockMailingList" class="componentSpacing {{ spacing ? spacing : '' }}"{{ options.backgroundColor and options.displayStyle != 'homepage' ? 'style="background-color: ' ~ options.backgroundColor ~ ';"' }} {{ backgroundColor ? 'style="background-color: ' ~ backgroundColor ~ ';"' }}  {{ options.theme ? 'data-theme="' ~ options.theme ~ '"' }} data-display-style="{{ options.displayStyle|default('default') }}">
  <div class="container" {{ imagePosition ? 'data-image-position="' ~ imagePosition ~ '"' }}>
    {% if image %}
      <figure class="figure" data-size="medium" data-align="center">
        {% if image.isThemeAsset %}
          <img class="figure-image" src="{{ image.src }}" alt="{{ image.alt|e }}" loading="lazy">
        {% elseif image.post_mime_type == 'image/svg+xml' %}
          <img
            class="figure-image-svg lazyload"
            src="{{ placeholderImage(image.width, image.height, 'rgba(125, 125, 125, 0.1)') }}"
            width="{{ image.width }}"
            height="{{ image.height }}"
            data-src="{{ image.src }}"
            alt="{{ image.alt|e }}">
        {% else %}
          <img
            class="figure-image lazyload"
            src="{{ image.src|resizeDynamic(768) }}"
            width="{{ image.width }}"
            height="{{ image.height }}"
            srcset="{{ placeholderImage(image.width, image.height, 'rgba(125, 125, 125, 0.1)') }}"
            data-srcset="
              {{ image.src|resizeDynamic(1920) }} 1920w,
              {{ image.src|resizeDynamic(1600) }} 1600w,
              {{ image.src|resizeDynamic(1440) }} 1440w,
              {{ image.src|resizeDynamic(1366) }} 1366w,
              {{ image.src|resizeDynamic(1024) }} 1024w,
              {{ image.src|resizeDynamic(768) }} 768w,
              {{ image.src|resizeDynamic(640) }} 640w"
            data-sizes="auto"
            alt="{{ image.alt|e }}">
        {% endif %}
        {% if image.caption %}
          <figcaption>{{ image.caption|e }}</figcaption>
        {% endif %}
      </figure>
    {% endif %}
    <div data-size="medium" class="content" data-align="center">
      {{ contentHtml|e('wp_kses_post') }}
    </div>
  </div>
</flynt-component>
