<div id="menu-container">
  <ul class="menu" id="navigationBurger-menu" data-ref="menu">
    {% for parent_index, item in items %}
    {% if not (ctaLink and item.title|lower == 'contact') %}
    <li class="item {{- item.current ? ' current-menu-item' }}">
      <a class="link parent-link" id="submenu-link-{{ parent_index }}"
         href="{{ item.link|e('esc_url') }}" {{- item.is_external or item.is_target_blank ? ' target="_blank" rel="noopener noreferrer"' -}}>{{ item.title }}</a>
        {% if item.children %}
          <svg class="arrow-icon parent-arrow" id="submenu-arrow-{{ parent_index }}" data-submenu="{{ parent_index }}" width="800px" height="800px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path
              d="M9.71069 18.2929C10.1012 18.6834 10.7344 18.6834 11.1249 18.2929L16.0123 13.4006C16.7927 12.6195 16.7924 11.3537 16.0117 10.5729L11.1213 5.68254C10.7308 5.29202 10.0976 5.29202 9.70708 5.68254C9.31655 6.07307 9.31655 6.70623 9.70708 7.09676L13.8927 11.2824C14.2833 11.6729 14.2833 12.3061 13.8927 12.6966L9.71069 16.8787C9.32016 17.2692 9.32016 17.9023 9.71069 18.2929Z"
              fill="#0F0F0F"/>
          </svg>
        {% endif %}
      {% if item.children %}
        <ul class="submenu" id="submenu-{{ parent_index }}" style="display: none" >
          {% for child_index, child in item.children %}
            <li class="submenu-item {{- child.current ? ' current-menu-item' }}">
              <a class="link child-link" id="sub-submenu-link-{{ parent_index }}-{{ child_index }}"
                 href="{{ child.link|e('esc_url') }}" {{- child.is_external or child.is_target_blank ? ' target="_blank" rel="noopener noreferrer"' -}}>{{ child.title }}</a>
              {% if child.children %}
                <svg class="arrow-icon child-arrow" id="sub-submenu-arrow-{{ parent_index }}-{{ child_index }}" data-sub-submenu="{{ parent_index }}-{{ child_index }}" width="800px" height="800px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M9.71069 18.2929C10.1012 18.6834 10.7344 18.6834 11.1249 18.2929L16.0123 13.4006C16.7927 12.6195 16.7924 11.3537 16.0117 10.5729L11.1213 5.68254C10.7308 5.29202 10.0976 5.29202 9.70708 5.68254C9.31655 6.07307 9.31655 6.70623 9.70708 7.09676L13.8927 11.2824C14.2833 11.6729 14.2833 12.3061 13.8927 12.6966L9.71069 16.8787C9.32016 17.2692 9.32016 17.9023 9.71069 18.2929Z"
                    fill="#0F0F0F"/>
                </svg>
              {% endif %}
              {% if child.children %}
                <ul class="sub-submenu" id="sub-submenu-{{ parent_index }}-{{ child_index }}" style="display: none">
                  {% for subchild in child.children %}
                    <li class="sub-submenu-item {{- subchild.current ? ' current-menu-item' }}">
                      <a class="link"
                         href="{{ subchild.link|e('esc_url') }}" {{- subchild.is_external or subchild.is_target_blank ? ' target="_blank" rel="noopener noreferrer"' -}}>{{ subchild.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
    {% endif %}
  {% endfor %}
  {% if ctaLink %}
    <li class="item menu-cta">
      <a class="btn" href="{{ ctaLink.url|e('esc_url') }}">{{ ctaLink.title }}</a>
    </li>
  {% endif %}
</ul>
</div>
