<a class="logo" href="{{ site.link|e('esc_url') }}">
  <span class="visuallyHidden">{{ logo.alt }}</span>
  <span class="logo-mark"><img src="{{ logo.markSrc }}" alt="" aria-hidden="true" fetchpriority="high"></span>
  <span class="logo-wordmark"><img src="{{ logo.wordmarkSrc }}" alt="" aria-hidden="true" fetchpriority="high"></span>
</a>
