<flynt-component name="BlockVideoOembed" load:on="visible" class="componentSpacing" {{ options.theme ? 'data-theme="' ~ options.theme ~ '"' }} data-display-style="{{ options.displayStyle|default('default') }}">
  <div class="container">
    {% if heading %}
      <h2 class="video-heading" data-size="{{ options.size }}" data-align="center">{{ heading|e }}</h2>
    {% endif %}
    <div class="video" data-size="{{ options.size }}" data-align="center">
      {% if posterImage %}
        {% include 'Partials/_figure.twig' ignore missing with {image: posterImage} only %}
      {% endif %}
      <div data-ref="videoPlayer" class="video-player">
        {{ oembed }}
        <div class="video-loader"></div>
        <button data-ref="playButton" class="video-playButton" type="button" aria-label="{{ labels.videoPlayButtonAriaLabel|e }}"></button>
      </div>
    </div>
    {% if button %}
      <div class="video-action" data-size="{{ options.size }}" data-align="center">
        <a class="button" href="{{ button.url|e('esc_url') }}" target="{{ button.target|default('_self')|e('html_attr') }}">
          {{ button.title }}
        </a>
      </div>
    {% endif %}
  </div>
</flynt-component>
