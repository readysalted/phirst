<flynt-component name="BlockFeedbackBanner">
  <div class="container">
    <img class="icon" src="{{ iconUrl }}" width="52" height="52" alt="" aria-hidden="true">
    <p class="message">
      {{ message }}
      {% if link.url %}
        <a href="{{ link.url|e('esc_url') }}" {{ link.target == '_blank' ? 'target="_blank" rel="noreferrer noopener"' }}>{{ link.title }}</a>
      {% endif %}
    </p>
  </div>
</flynt-component>
