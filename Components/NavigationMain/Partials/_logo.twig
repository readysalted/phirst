<a class="logo" href="{{ site.link|e('esc_url') }}">
  <span class="visuallyHidden">{{ logo.alt }}</span>
  <img class="logo-image logo-image--mark" width="164" height="43" src="{{ logo.markSrc }}" fetchpriority="high" alt="" aria-hidden="true">
  <img class="logo-image logo-image--wordmark" width="155" height="43" src="{{ logo.wordmarkSrc }}" fetchpriority="high" alt="" aria-hidden="true">
</a>
