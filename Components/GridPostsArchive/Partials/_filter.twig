<ul class="filter" aria-label="{{ labels.filterBy|default('Filter by') }}">
  {% for term in terms %}
    <li class="item">
      <a href="{{ term.link|e('esc_url') }}" class="button {{- term.isActive ? '' : ' button--outlined' }}" {% if term.isActive %}aria-current="page"{% endif %}>
        <span class="visuallyHidden">{{ labels.filterBy|e }}</span>{{ term.title }}
      </a>
    </li>
  {% endfor %}
</ul>
