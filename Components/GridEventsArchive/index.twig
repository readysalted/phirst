<flynt-component name="GridEventsArchive" load:on="visible" class="componentSpacing" {{ options.theme ? 'data-theme="' ~ options.theme ~ '"' }}>
  <div class="container" data-flow="layout">
    {% if events|length > 0 %}
      <ul data-ref="events" class="events">
        {% for event in events %}
          {% set aria_labelledby_id = uuid ~ '-' ~ loop.index %}
          <li class="event boxCard {{ event.isPastEvent ? 'event--past' }}" data-theme="reset">
            <a class="link" href="{{ event.link|e('esc_url') }}" aria-labelledby="{{ aria_labelledby_id }}">
              <figure class="figure">
                {% if event.eventDate %}
                  <div class="event-date-label">
                    <span class="event-date-day">{{ event.eventDate.day }}</span>
                    <span class="event-date-month">{{ event.eventDate.month }}</span>
                    <span class="event-date-year">{{ event.eventDate.year }}</span>
                  </div>
                {% endif %}

                {% if event.thumbnail %}
                  <img
                    class="event-image figure-image lazyload"
                    src="{{ event.thumbnail.src|resizeDynamic(768, (768 / 3 * 2)|round, 'center') }}"
                    width="768"
                    height="{{ (768 / 3 * 2)|round }}"
                    srcset="{{ placeholderImage(768, (768 / 3 * 2)|round, 'rgba(125, 125, 125, 0.1)') }}"
                    data-srcset="
                      {{ event.thumbnail.src|resizeDynamic(1920, (1920 / 3 * 2)|round, 'center') }} 1920w,
                      {{ event.thumbnail.src|resizeDynamic(1600, (1600 / 3 * 2)|round, 'center') }} 1600w,
                      {{ event.thumbnail.src|resizeDynamic(1440, (1440 / 3 * 2)|round, 'center') }} 1440w,
                      {{ event.thumbnail.src|resizeDynamic(1366, (1366 / 3 * 2)|round, 'center') }} 1366w,
                      {{ event.thumbnail.src|resizeDynamic(1024, (1024 / 3 * 2)|round, 'center') }} 1024w,
                      {{ event.thumbnail.src|resizeDynamic(768, (768 / 3 * 2)|round, 'center') }} 768w,
                      {{ event.thumbnail.src|resizeDynamic(640, (640 / 3 * 2)|round, 'center') }} 640w"
                    data-sizes="auto"
                    alt="{{ event.thumbnail.alt|e }}">
                {% else %}
                  <div class="event-placeholder-image">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                  </div>
                {% endif %}

                {% if event.isPastEvent %}
                  <span class="event-past-badge">{{ labels.pastEvent }}</span>
                {% endif %}
              </figure>
              <div class="content boxPadding">
                <h2 class="h5" id="{{ aria_labelledby_id }}">{{ event.title }}</h2>
                {% if event.eventDate %}
                  <p class="event-time">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span class="event-time-range">
                      <span class="event-time-start">{{ event.eventDate.time }}</span>
                      {% if event.eventDate.endTime %}
                        <span class="event-time-separator">-</span>
                        <span class="event-time-end">{{ event.eventDate.endTime }}</span>
                      {% endif %}
                    </span>
                  </p>
                {% endif %}
              </div>
              <footer class="footer">
                <span>{{ labels.viewEvent }}</span>
              </footer>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="events-empty">{{ labels.noEventsFound }}</p>
    {% endif %}

    {% set pagination = posts.pagination %}
    {% if pagination.pages %}
      {% include 'Partials/_pagination.twig' %}
    {% endif %}
  </div>
</flynt-component>
