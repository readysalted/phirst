<flynt-component name="GridImageText" class="componentSpacing" {{ options.theme ? 'data-theme="' ~ options.theme ~ '"' }} data-display-style="{{ options.displayStyle|default('default') }}">
  <div class="container" data-flow="layout">
    {% if preContentHtml %}
      <div class="grid-title" data-align="{{ titleAlignment }}">
        {{ preContentHtml|e('wp_kses_post') }}
      </div>
    {% endif %}
    <ul class="grid" data-max-columns="{{ maxColumns }}" data-card="{{ options.card ? 'true' : 'false' }}">
      {% for item in items %}
        <li class="item boxCard">
          {% if item.image %}
            <figure class="figure figure-desktop">
              <img src="{{ item.image.src }}" alt="{{ item.image.alt }}" loading="lazy">
            </figure>
          {% endif %}
          {% if maxColumns == '1' and item.imageMobile %}
            <figure class="figure figure-mobile">
              <img src="{{ item.imageMobile.src }}" alt="{{ item.imageMobile.alt }}" loading="lazy">
            </figure>
          {% endif %}
          <div class="content">
            {{ item.contentHtml|e('wp_kses_post') }}
          </div>
          {% if item.link.url %}
            <a class="item-link" href="{{ item.link.url }}" target="{{ item.link.target }}" aria-label="Read more"></a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
    {% if button.url %}
      <a class="grid-button button" href="{{ button.url }}" target="{{ button.target|default('_self') }}">{{ button.title }}</a>
    {% endif %}
  </div>
</flynt-component>
