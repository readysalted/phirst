<flynt-component name="GridPostsRepeater" {{ data.options.theme ? 'data-theme="' ~ data.options.theme ~ '"' }}>
  <div class="container">
    <div class="grid-wrap">
      {% for value in items %}
        {% if value.link %}
          <a class="grid-element"
             href="{{ value.link.url }}" {{ value.link.target == '_blank' ? 'target="_blank" rel="noreferrer noopener"' }}>
            {% if value.image.src %}
              <div class="grid-element__image" style="background: url('{{ value.image.src }}')"></div>
            {% endif %}
            <p class="grid-element__title">{{ value.link.title }}</p>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</flynt-component>
