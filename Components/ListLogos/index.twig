<flynt-component name="ListLogos" load:on="visible" class="componentSpacing" {{ options.theme ? 'data-theme="' ~ options.theme ~ '"' }} data-display-style="{{ options.displayStyle|default('default') }}">
  <div class="container" data-flow="layout">
    {% if preContentHtml %}
      <div class="content" data-align="center" >
        {{ preContentHtml|e('wp_kses_post') }}
      </div>
    {% endif %}
    <ul class="items"{% if options.displayStyle == 'homepagePartners' %} data-ref="scroller" aria-label="{{ labels.partnerLogos|e }}"{% endif %}>
      {% for item in items %}
        <li class="item {{ options.card ? 'boxPadding' }}" {{ options.card ? 'data-theme="reset"' }}>
            {% if item.link %}
              <a class="link" href="{{ item.link.url|e('esc_url') }}" title="{{ item.link.title|e }}" {{ item.link.target == '_blank' ? 'target="_blank" rel="noreferrer noopener"' }}>
                <span class="visuallyHidden"> {{ item.link.title|e }} </span>
              </a>
            {% endif %}
            {% if item.image.isThemeAsset %}
              <figure class="figure"><img class="figure-image" src="{{ item.image.src }}" alt="{{ item.image.alt|e }}" loading="lazy"></figure>
            {% else %}
              {% include 'Partials/_image.twig' with {image: item.image, link: item.link, type: options.card} only %}
            {% endif %}
        </li>
      {% endfor %}
    </ul>
    {% if options.displayStyle == 'homepagePartners' %}
      <button class="partner-progress" type="button" data-ref="progress" aria-label="{{ labels.scrollPartnerLogos|e }}" disabled>
        <span data-ref="progressThumb"></span>
      </button>
    {% endif %}
  </div>
</flynt-component>
