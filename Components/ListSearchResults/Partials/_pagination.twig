<nav class="pagination" aria-label="Search results pagination">
  {% if pagination.prev %}
    <a rel="prev" href="{{ pagination.prev.link|e('esc_url') }}" class="button button--outlined button-previous">{{ labels.previous }}</a>
  {% endif %}
  <ol class="pagination-pages">
    {% for page in pagination.pages %}
      <li>
        {% if page.link %}
          <a class="pagination-page" href="{{ page.link|e('esc_url') }}" aria-label="Page {{ page.title|e }}">{{ page.title }}</a>
        {% else %}
          <span class="pagination-page {{ page.current ? 'is-current' }}" {% if page.current %}aria-current="page"{% endif %}>{{ page.title }}</span>
        {% endif %}
      </li>
    {% endfor %}
  </ol>
  {% if pagination.next %}
    <a rel="next" href="{{ pagination.next.link|e('esc_url') }}" class="button button--outlined button-next">{{ labels.next }}</a>
  {% endif %}
</nav>
